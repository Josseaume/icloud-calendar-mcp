#!/bin/sh
# Garde-fou Git : refuse un commit qui ajoute une ligne ressemblant à un mot de
# passe pour app Apple (4 groupes de 4 lettres minuscules séparés par des tirets).
# Le motif d'exemple « xxxx-xxxx-xxxx-xxxx » de la doc est ignoré.
# Activé par : git config core.hooksPath .githooks

if git diff --cached -U0 \
  | grep -E '^\+' \
  | grep -v 'xxxx-xxxx-xxxx-xxxx' \
  | grep -qE '(^|[^a-z])[a-z]{4}-[a-z]{4}-[a-z]{4}-[a-z]{4}([^a-z]|$)'; then
  echo "Commit refusé : une ligne ajoutée ressemble à un mot de passe pour app Apple." >&2
  echo "Les secrets vont dans le Trousseau macOS, jamais dans le dépôt." >&2
  exit 1
fi
